rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Authentication & Role-Based Access Control (RBAC) Security Helpers
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    function isExecutive() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'executive' ||
        request.auth.token.executive == true ||
        (exists(/databases/$(database)/documents/Users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/Users/$(request.auth.uid)).data.isExecutive == true)
      );
    }

    // Input Validation Helpers
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // =========================================================================
    // 1. Users Collection (Secure PII Protection - Anti-Scraping & Privacy)
    // =========================================================================
    match /Users/{userId} {
      // Individual document read: Only the user themselves, club executives, or admins can read
      allow get: if isOwner(userId) || isExecutive() || isAdmin();

      // Bulk query/listing: Only club executives and admins can query the user directory
      allow list: if isExecutive() || isAdmin();

      // Creation: Account owner can initialize their profile
      allow create: if isOwner(userId) &&
        (!('isRestricted' in request.resource.data) || request.resource.data.isRestricted == false);

      // Updates: Club executives and admins can update any user; account owners can update their profile
      allow update: if isExecutive() || isAdmin() || (
        isOwner(userId) &&
        (!('isRestricted' in request.resource.data) || request.resource.data.isRestricted == resource.data.isRestricted)
      );

      // Deletion: Only the account owner or admin can delete their profile
      allow delete: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 2. Payments Collection (Bills, Dues, and Payment Transaction Ledger)
    // =========================================================================
    match /Payments/{paymentId} {
      // Authenticated users can read payment bills and dues
      allow get, list: if isAuthenticated();

      // Authenticated users and executives can create payment bills or log receipts
      allow create: if isAuthenticated();

      // Authenticated users can update payment completion status, or executives/admins
      allow update: if isAuthenticated();

      // Only admins can delete payment records
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. Usernames Index (Privacy-Preserving Unique Username Checks)
    // =========================================================================
    match /Usernames/{username} {
      // Anyone can check if a specific username document exists
      allow get: if true;
      // Listing all usernames is restricted to authenticated users
      allow list: if isAuthenticated();
      // Only the claimed user can write/delete their own username reservation
      allow create, update: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // =========================================================================
    // 3. Subscribers Collection (Anti-Scraping Protection for Mailing Lists)
    // =========================================================================
    match /Subscribers/{subscriberEmail} {
      // Allow single email lookup for subscription self-management
      allow get: if true;

      // FORBID bulk listing/dumping of subscriber emails by scrapers
      allow list: if isExecutive() || isAdmin();

      // Allow creating and updating subscriptions with valid email string
      allow create, update: if isValidString(subscriberEmail, 3, 254);

      // Allow unsubscribing/deleting
      allow delete: if true;
    }

    // =========================================================================
    // 4. Organizations Collection (Global Debate Directory)
    // =========================================================================
    match /Organizations/{orgId} {
      // Allow reading organizations directory; client strictly filters out internal _default
      allow read: if true;
      allow create, update, delete: if isExecutive() || isAdmin();
    }

    // =========================================================================
    // 5. Executive-Previous Collection (Historical Executive Teams)
    // =========================================================================
    match /Executive-Previous/{yearId} {
      // Anyone can read past executive history
      allow read: if true;
      // Only club executives and admins can create, update, or delete historical executive records
      allow create, update, delete: if isExecutive() || isAdmin();
    }

    // =========================================================================
    // 6. Legacy Users Collection (Backwards Compatibility)
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isExecutive() || isAdmin();
      allow list: if isExecutive() || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 6. Events, Tournaments, Announcements & Feedback
    // =========================================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isExecutive();
      allow delete: if isAdmin() || isExecutive();
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update: if isExecutive();
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isExecutive();
      allow delete: if isAdmin() || isExecutive();
    }

    match /applications/{applicationId} {
      allow read: if isExecutive() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isValidString(request.resource.data.content, 1, 10000);

      allow update: if (
        isExecutive() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'draft' &&
          request.resource.data.userId == request.auth.uid
        )
      );

      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow create: if isValidString(request.resource.data.message, 1, 3000);
      allow read, update, delete: if isAdmin();
    }

    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
