rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication & Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isExecutive() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'executive' ||
        request.auth.token.executive == true
      );
    }

    function isMember() {
      return isAuthenticated() && (
        isExecutive() ||
        request.auth.token.role == 'member' ||
        request.auth.token.member == true
      );
    }

    // Validation Helpers
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        isValidString(request.resource.data.email, 3, 254) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'member') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);

      allow update: if (
        isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.uid == resource.data.uid &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
          (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin)
        )
      );

      allow delete: if isAdmin();
    }

    // Events
    match /events/{eventId} {
      allow read: if true;
      allow create: if isExecutive() &&
        isValidString(request.resource.data.title, 1, 200) &&
        isValidString(request.resource.data.description, 0, 5000);
      allow update: if isExecutive();
      allow delete: if isAdmin() || isExecutive();
    }

    // Tournaments & Results
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update: if isExecutive();
      allow delete: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update: if isExecutive();
      allow delete: if isAdmin() || isExecutive();
    }

    // Applications (e.g. Executive applications, tournament delegations)
    match /applications/{applicationId} {
      allow read: if isExecutive() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isValidString(request.resource.data.content, 1, 10000);

      allow update: if (
        isExecutive() ||
        (
          isAuthenticated() &&
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'draft' &&
          request.resource.data.userId == request.auth.uid
        )
      );

      allow delete: if isAdmin();
    }

    // Feedback & Inquiries
    match /feedback/{feedbackId} {
      allow create: if isValidString(request.resource.data.message, 1, 3000);
      allow read, update, delete: if isAdmin();
    }

    // System Configuration
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
